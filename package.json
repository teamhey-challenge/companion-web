{
  "name": "companion-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ui-web",
    "apps/passenger-web"
  ],
  "scripts": {
    "sb": "storybook dev -p 6106 --no-open",
    "sb:build": "storybook build -o storybook-static",
    "check:css": "node scripts/check-css.mjs",
    "lint": "eslint .",
    "check:stories": "node scripts/check-stories.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "perf:timing": "node scripts/perf-timing.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "dev:web": "bun run --cwd apps/passenger-web dev",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "node scripts/check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@storybook/addon-a11y": "^9.1.0",
    "@storybook/addon-docs": "^9.1.0",
    "@storybook/react-vite": "^9.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.0",
    "globals": "^16.0.0",
    "playwright-core": "1.64.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remark-gfm": "^4",
    "sharp": "^0.35.5",
    "storybook": "^9.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
